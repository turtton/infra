      "title": "Average MSPT",
      "type": "timeseries",
      "targets": [
        {
          "expr": "1000 * sum(rate(mc_server_tick_seconds_sum{namespace=\"atm10\", endpoint=\"metrics\"}[$__rate_interval])) / clamp_min(sum(rate(mc_server_tick_seconds_count{namespace=\"atm10\", endpoint=\"metrics\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "Average MSPT",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "pointSize": 5, "showPoints": "never" },
