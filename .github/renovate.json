{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>turtton/renovate"
  ],
  "flux": {
    "managerFilePatterns": ["/clusters/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "停止中のFluxer旧upstream参照はrollback用に固定し、自動更新は専用Actionsで管理する",
      "matchManagers": ["flux"],
      "matchFileNames": ["clusters/main/apps/fluxer/source-gitrepository.yaml"],
      "enabled": false
    },
    {
      "description": "Fluxer vendor原本とアプリimageは専用Actionsでまとめて更新し、Renovateとの二重更新を避ける",
      "matchFileNames": [
        "charts/fluxer/**",
        "clusters/main/apps/fluxer/images.lock.json",
        "clusters/main/apps/fluxer/helmrelease-admin.yaml",
        "clusters/main/apps/fluxer/helmrelease-api.yaml",
        "clusters/main/apps/fluxer/helmrelease-app-proxy.yaml",
        "clusters/main/apps/fluxer/helmrelease-gateway.yaml",
        "clusters/main/apps/fluxer/helmrelease-media-proxy.yaml",
        "clusters/main/apps/fluxer/helmrelease-messages.yaml",
        "clusters/main/apps/fluxer/helmrelease-snowflakes.yaml",
        "clusters/main/apps/fluxer/helmrelease-unfurl.yaml",
        "clusters/main/apps/fluxer/helmrelease-users.yaml"
      ],
      "enabled": false
    },
    {
      "description": "ネットワーク・ストレージ等の基盤コントローラはアプリと別PRにする (同時ロールアウト事故防止)",
      "matchFileNames": ["clusters/main/infrastructure/**"],
      "groupName": "infrastructure controllers"
    },
    {
      "description": "Flux本体のコンポーネント更新は単独PRにする",
      "matchFileNames": ["clusters/main/flux-system/**"],
      "groupName": "flux components"
    },
    {
      "description": "監視スタック (kube-prometheus-stack/loki/alloy) はまとめて1PRにする",
      "matchFileNames": [
        "clusters/main/apps/monitoring/**",
        "clusters/main/apps/loki/**",
        "clusters/main/apps/alloy/**"
      ],
      "groupName": "monitoring stack"
    }
  ]
}
